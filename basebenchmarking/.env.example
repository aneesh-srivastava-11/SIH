# Image Registration Benchmarking Platform - Environment Configuration

# Web Dashboard Port
PORT=5000

# Custom Data & Output Directory Overrides (Optional)
# BENCHMARK_DATA_DIR=data/pairs
# BENCHMARK_OUTPUT_DIR=results

# GPU Configuration
CUDA_VISIBLE_DEVICES=0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Flask Environment
FLASK_ENV=development
